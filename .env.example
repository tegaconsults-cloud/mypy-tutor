
# ──────────────────────────────────────────────────────────────────────────────
# MyPy Tutor — Environment Variables
# Copy this file to .env for local development.
# On Render: set each key in Dashboard → Environment (NO surrounding quotes).
# ──────────────────────────────────────────────────────────────────────────────

# ── Admin ─────────────────────────────────────────────────────────────────────
ADMIN_EMAIL=tega.com.ng@gmail.com
ADMIN_PASSWORD=set-a-strong-password-here
SESSION_SECRET=MyPyTutor-Secret-2025-Teamsamikoko-Secure
# ⚠️  IMPORTANT: Change SESSION_SECRET to a strong random value before deploying.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
# The example value above is publicly known — using it in production allows session forgery.

# ── AI ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── GitHub OAuth ──────────────────────────────────────────────────────────────
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ── Email — Primary: Resend ───────────────────────────────────────────────────
# Get your key at: https://resend.com/api-keys
# FREE tier: 3,000 emails/month
# Verify your domain (mypytutor.com.ng) in Resend dashboard before going live.
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=MyPy Tutor <noreply@mypytutor.com.ng>
SUPPORT_EMAIL=support@mypytutor.com.ng

# ── Email — Fallback: Gmail SMTP ─────────────────────────────────────────────
# Only used when RESEND_API_KEY is not set or Resend fails.
# EMAIL_PASS must be a Gmail App Password (16 chars, no spaces), NOT your normal password.
# Create at: https://myaccount.google.com/apppasswords (requires 2FA)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=abcdefghijklmnop

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=https://mypytutor.onrender.com
FRONTEND_URL=https://mypytutor.com.ng

# ── Paystack ──────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# ── Supabase ──────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Bank Transfer Details (shown to users on checkout) ───────────────────────
BANK_NAME=Zenith Bank Plc
BANK_ACCOUNT_NAME=Teamsamikoko Global Academy
BANK_ACCOUNT_NUMBER=set-your-account-number-here

# ── PostgreSQL Database — PRIMARY: Supabase ──────────────────────────────────
# PRIMARY DATABASE is Supabase PostgreSQL Session Pooler (IPv4, permanent).
# Get from: Supabase → Settings → Database → Connection string → URI → Session pooler
# Format: postgresql://postgres.YOURREF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# IMPORTANT: Use the Session Pooler (not direct connection) — direct uses IPv6 which Render blocks
DATABASE_URL=postgresql://postgres.YOURREF:YOUR_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres

# ── SQLite Persistent Disk (legacy — no longer used, replaced by PostgreSQL) ──
# DB_PATH=/data/mypytutor.db
